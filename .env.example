# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# EskomSePush API token (https://eskomsepush.gumroad.com/l/api)
SEPUSH_TOKEN=your-sepush-api-token

# EskomSePush area ID for your suburb (find it via the /areas_search endpoint)
SEPUSH_AREA_ID=your-area-id

# Tuya IR blaster device ID (the physical blaster, not a virtual remote)
TUYA_IR_DEVICE_ID=your-tuya-ir-device-id

# Tuya virtual remote ID for the TV
TUYA_IR_REMOTE_ID=your-tuya-remote-id
